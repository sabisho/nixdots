layout {

    focus-ring {
        active-color   "#ffc0a2"
        inactive-color "#1a120e"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffc0a2"
        inactive-color "#1a120e"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ffc0a2"
        inactive-color "#fe9963"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffc0a280"
    }
}

recent-windows {
    highlight {
        active-color "#ffc0a2"
        urgent-color "#ffb4ab"
    }
}
