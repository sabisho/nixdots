layout {

    focus-ring {
        active-color   "#d8c59b"
        inactive-color "#151310"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d8c59b"
        inactive-color "#151310"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#d8c59b"
        inactive-color "#7a6b48"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d8c59b80"
    }
}

recent-windows {
    highlight {
        active-color "#d8c59b"
        urgent-color "#ffb4ab"
    }
}
