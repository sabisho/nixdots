layout {

    focus-ring {
        active-color   "#9ad1ca"
        inactive-color "#111413"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#9ad1ca"
        inactive-color "#111413"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#9ad1ca"
        inactive-color "#659a94"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#9ad1ca80"
    }
}

recent-windows {
    highlight {
        active-color "#9ad1ca"
        urgent-color "#ffb4ab"
    }
}
