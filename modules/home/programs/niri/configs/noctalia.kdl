layout {

    focus-ring {
        active-color   "#c9c1ec"
        inactive-color "#141316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c9c1ec"
        inactive-color "#141316"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#c9c1ec"
        inactive-color "#3b3659"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c9c1ec80"
    }
}

recent-windows {
    highlight {
        active-color "#c9c1ec"
        urgent-color "#ffb4ab"
    }
}
