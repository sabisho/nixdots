layout {

    focus-ring {
        active-color   "#92cfec"
        inactive-color "#111415"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#92cfec"
        inactive-color "#111415"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#92cfec"
        inactive-color "#2b6c86"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#92cfec80"
    }
}

recent-windows {
    highlight {
        active-color "#92cfec"
        urgent-color "#ffb4ab"
    }
}
