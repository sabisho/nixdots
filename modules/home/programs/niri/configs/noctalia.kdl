layout {

    focus-ring {
        active-color   "#b3c6fa"
        inactive-color "#121316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b3c6fa"
        inactive-color "#121316"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#b3c6fa"
        inactive-color "#3c4f7c"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b3c6fa80"
    }
}

recent-windows {
    highlight {
        active-color "#b3c6fa"
        urgent-color "#ffb4ab"
    }
}
