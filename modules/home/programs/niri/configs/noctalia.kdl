layout {

    focus-ring {
        active-color   "#79d7c1"
        inactive-color "#101413"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#79d7c1"
        inactive-color "#101413"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#79d7c1"
        inactive-color "#047c69"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#79d7c180"
    }
}

recent-windows {
    highlight {
        active-color "#79d7c1"
        urgent-color "#ffb4ab"
    }
}
