layout {

    focus-ring {
        active-color   "#b8c9d2"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b8c9d2"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#b8c9d2"
        inactive-color "#1c2c33"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b8c9d280"
    }
}

recent-windows {
    highlight {
        active-color "#b8c9d2"
        urgent-color "#ffb4ab"
    }
}
